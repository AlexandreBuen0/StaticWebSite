# Cloudflare Pages reads this file from the root of the build output.
# https://developers.cloudflare.com/pages/configuration/headers/

# ── Global ────────────────────────────────────────────────────────────────────
# CSP must stay on ONE line — Pages does not support line continuations.
#
# THREE variants below — exactly ONE Content-Security-Policy line may be active
# (uncommented) at a time; the others stay commented with a leading '#':
#
#   C) PERMISSIVE (active): scripts are effectively unrestricted — any HTTPS origin
#      plus 'unsafe-inline' and 'unsafe-eval'. Required because Google Tag Manager
#      bootstraps from an INLINE <script> block, which no scheme keyword can allow,
#      and because the Inbound Insight chain uses eval/new Function. img-src, frame-src
#      and connect-src are opened for the same reason: tracking beacons are images,
#      the GTM <noscript> fallback is an iframe, and the identity chain posts to hosts
#      that cannot be enumerated ahead of time. Trade-off: CSP no longer restricts
#      scripts at all — an injected script is neither blocked from loading nor from
#      exfiltrating. TEST SITE ONLY. object-src, base-uri and frame-ancestors still
#      apply, so clickjacking and base-tag hijacking stay blocked.
#
#   A) LOOSENED (commented): script-src / connect-src allow any HTTPS origin via the
#      `https:` scheme keyword, but NOT inline. Was enough for the pixel injected
#      directly, but BLOCKS the GTM bootstrap. Keep for reference.
#
#   B) EXPLICIT (commented): the enumerated host allow-list. Tighter, and the right
#      shape for a real customer prod site — but note it needs TWO additions before
#      it can work with GTM: https://www.googletagmanager.com in script-src (and in
#      img-src / frame-src), and an inline allowance for the GTM bootstrap — either
#      'unsafe-inline' or the sha256 hash of the exact pasted block. A nonce is NOT
#      possible from this file: _headers is static, so a per-request nonce requires
#      moving CSP emission into a Pages Function (functions/_middleware.js).
#      Third-party script hosts, for reference:
#        websitevisitorleads.com + app-dev.lettrlabs.com   → lead-reveal pixel
#        pixel-controller-worker.inbound-insight.workers.dev → injected by px.js
#        static.cloudflareinsights.com                       → CF Web Analytics beacon
#        www.googletagmanager.com                            → GTM container + noscript iframe
#        script-src : s3-us-west-2.amazonaws.com (ge.js), rdcdn.com (rtjs),
#                     data.processwebsitedata.com (cscripts), fe.sitedataprocessing.com,
#                     b-code.liadm.com (LiveIntent lc2.js)
#        connect-src: a.usbrowserspeed.com, alocdn.com (ge.js identity beacons)
/*
  Content-Security-Policy: default-src 'self' https: data: blob:; script-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https: wss:; frame-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
#  Content-Security-Policy: default-src 'self'; script-src 'self' https:; style-src 'self'; img-src 'self' data: https://app-dev.lettrlabs.com https://pixel-controller-worker.inbound-insight.workers.dev; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
#  Content-Security-Policy: default-src 'self'; script-src 'self' https://app-dev.lettrlabs.com https://pixel-controller-worker.inbound-insight.workers.dev https://static.cloudflareinsights.com https://s3-us-west-2.amazonaws.com https://rdcdn.com https://data.processwebsitedata.com https://fe.sitedataprocessing.com https://b-code.liadm.com; style-src 'self'; img-src 'self' data: https://app-dev.lettrlabs.com https://pixel-controller-worker.inbound-insight.workers.dev; font-src 'self'; connect-src 'self' https://app-dev.lettrlabs.com https://pixel-controller-worker.inbound-insight.workers.dev https://s3-us-west-2.amazonaws.com https://rdcdn.com https://data.processwebsitedata.com https://fe.sitedataprocessing.com https://b-code.liadm.com https://a.usbrowserspeed.com https://alocdn.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# ── Static assets ─────────────────────────────────────────────────────────────
# Fingerprint these filenames (bootstrap.min.abc123.css) before trusting the long max-age.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── HTML ──────────────────────────────────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate
